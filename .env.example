# Copy to .env and edit. Everything here is optional.

# LLM for answers, as "provider:model" (langchain init_chat_model format).
# If unset: Claude when ANTHROPIC_API_KEY is set, otherwise OpenAI when OPENAI_API_KEY is set.
# LLM_MODEL=anthropic:claude-opus-5-5
# LLM_MODEL=openai:gpt-5-mini
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# LLM that grades answers in scripts/eval_ragas.py. Defaults to LLM_MODEL.
# JUDGE_MODEL=

# Qdrant server (docker compose up -d). If unset, Qdrant runs embedded in ./qdrant_data.
# QDRANT_URL=http://localhost:6333

# Retrieval knobs worth experimenting with (re-run ingest after changing chunk settings).
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200
# CANDIDATES=30
# TOP_K=5
# DENSE_MODEL=BAAI/bge-small-en-v1.5
# RERANK_MODEL=jinaai/jina-reranker-v1-tiny-en   (or Xenova/ms-marco-MiniLM-L-6-v2, BAAI/bge-reranker-base)
# ENCODER_BATCH=1
